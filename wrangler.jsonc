{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ok-photowork",
  "main": "src/worker.js",
  "compatibility_date": "2026-06-01",
  "assets": {
    "directory": "./public",
    "run_worker_first": ["/api/*"]
  },
  "kv_namespaces": [{ "binding": "SITE", "id": "3504f3f98f714ad1aab3221a52e0419a" }],
  "r2_buckets": [{ "binding": "PHOTOS", "bucket_name": "ok-photowork-photos" }]
}
