{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ok-photowork",
  "main": "src/worker.js",
  "compatibility_date": "2026-06-01",
  "assets": {
    "directory": "./public",
    "run_worker_first": ["/api/*"]
  },
  "kv_namespaces": [{ "binding": "SITE" }],
  "r2_buckets": [{ "binding": "PHOTOS" }]
}
